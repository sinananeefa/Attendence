# ============================================================
# Edumerge Smart Attendance — Environment Variable Reference
# ============================================================
# Copy this file to .env (in the backend/ directory) and fill in
# real values.  NEVER commit .env or any file containing real values.
# .env is already in .gitignore; verify before pushing.
# ============================================================


# ── Django core ──────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-long-random-string-at-least-50-characters

# Set to "true" only for local development; must be "false" in production
DJANGO_DEBUG=false

# Space-separated list of hostnames that Django will serve, e.g.:
#   DJANGO_ALLOWED_HOSTS=api.yourdomain.com
# Leave unset (or use "localhost 127.0.0.1") for local dev with DEBUG=true
DJANGO_ALLOWED_HOSTS=


# ── Database ──────────────────────────────────────────────────
# Leave MYSQL_DATABASE unset to use SQLite (local dev default).
# Set all MYSQL_* variables together to use MySQL.

MYSQL_DATABASE=edumerge_attendance
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Optional: override SQLite file path (only used when MYSQL_DATABASE is unset)
# SQLITE_PATH=/absolute/path/to/db.sqlite3


# ── CORS ─────────────────────────────────────────────────────
# Space-separated list of allowed frontend origins (exact match), e.g.:
#   CORS_ALLOWED_ORIGINS=https://app.yourdomain.com http://localhost:5173
# In production, this MUST be set. When DEBUG=false and this is unset,
# all cross-origin requests will be denied.
CORS_ALLOWED_ORIGINS=http://localhost:5173 http://localhost:5175


# ── Security (production only — ignored when DJANGO_DEBUG=true) ──
# Set to "false" only if your reverse proxy handles HTTPS termination
# and you don't want Django to redirect HTTP -> HTTPS itself.
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

# Connection pool age in seconds (MySQL only)
DB_CONN_MAX_AGE=60


# ── Email ─────────────────────────────────────────────────────
# When unset, emails are printed to the console (dev default).
# For production SMTP:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yourmailprovider.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your_email_username
EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
